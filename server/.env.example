NODE_ENV=development
HOST=0.0.0.0
PORT=4000

PGHOST=localhost
PGPORT=5432
PGDATABASE=moni-D
PGUSER=postgres
PGPASSWORD=your_password

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=your_email@domain.com

CORS_ORIGIN=http://localhost:5173
RETENTION_DAYS=90
SYNC_INTERVAL_SEC=60

AUTH_TOKEN_TTL_HOURS=168

CPU_ALERT_PCT=85
MEM_ALERT_PCT=90
DISK_ALERT_PCT=90
ALERT_COOLDOWN_MIN=30
AGENT_KEY=your_agent_key

# Vigilancia del propio monitor.
# El umbral de atraso se calcula solo desde el check_interval_sec mas alto de
# los nodos activos; estas variables solo lo acotan.
HEALTH_STALE_FACTOR=3
HEALTH_STALE_MIN_SEC=300
# 0 = usar el calculo automatico. Cualquier otro valor lo fuerza.
HEALTH_STALE_AFTER_SEC=0
# Si el monitoreo se traba, termina el proceso para que PM2 lo reinicie.
WATCHDOG_EXIT_ON_STALL=true
WATCHDOG_GRACE_SEC=600
